[resource]
script = ExtResource("1")
id = "heal"
display_name = "Heal"
description = "Mend wounds, restoring lost HP. Weak at first - deliberately weaker than a basic attack until your Healing skill catches up. Does nothing for someone already at 0 HP - see Revive for that."
