; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Statbreaker"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("26.2", "Redot")

[autoload]

EntityRegistry="*res://systems/entity_registry.gd"
TurnScheduler="*res://systems/turn_scheduler.gd"
Grid="*res://systems/grid.gd"
ActionResolver="*res://systems/action_resolver.gd"
AIController="*res://systems/ai_controller.gd"
SkillRegistry="*res://systems/skill_registry.gd"
ProgressionSystem="*res://systems/progression_system.gd"
AbilityRegistry="*res://systems/ability_registry.gd"
EffectLibrary="*res://systems/effect_library.gd"
